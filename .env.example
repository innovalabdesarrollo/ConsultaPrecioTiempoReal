# MongoDB Atlas — UNA sola URI; el nombre de DB va en la ruta (consulta-precio-tiemporeal)
# Ejemplo: mongodb+srv://USER:PASS@CLUSTER.mongodb.net/consulta-precio-tiemporeal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/consulta-precio-tiemporeal?retryWrites=true&w=majority

# Secreto para cifrar credenciales del proveedor (AES-256-GCM). Mín. 16 caracteres.
CREDENTIALS_SECRET=cambia-este-secreto-local

# Token de acceso a /admin (header X-Admin-Token). Mín. 8 caracteres.
ADMIN_TOKEN=cambia-admin-token

# Puerto API de ESTE proyecto (no reutilizar el de otra app Innovalab)
PORT=3001
# Puerto frontend (Vite). Si choca, cámbialo aquí; strictPort no roba otro puerto.
WEB_PORT=5173

# --- Proveedor inicial (solo si Mongo aún no tiene ninguno) ---
# Luego agrega más desde /admin: nombre + URL + usuario + password.
PROVIDER_NOMBRE=Demo local
PROVIDER_TIPO=mock
PROVIDER_USUARIO=demo
PROVIDER_PASSWORD=demo
# Para el primero en HTTP:
# PROVIDER_TIPO=http
# PROVIDER_BASE_URL=https://api.tu-proveedor.com
# Contrato HTTP:
#   POST {BASE}/auth → { token }
#   GET  {BASE}/productos?q=  Authorization: Bearer {token} → { productos: [...] }


# Caché de consultas idénticas (segundos). 0 = desactivar.
CACHE_TTL_SECONDS=60

# Node.js requerido: >=24.22.1 (parche CVE-2026-111497 Node2Shell / Brotli)



