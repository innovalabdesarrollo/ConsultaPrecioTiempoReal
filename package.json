{
  "name": "consulta-precio-tiemporeal",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @cpt/api dev",
    "dev:web": "pnpm --filter @cpt/web dev",
    "build": "pnpm --filter @cpt/web build",
    "test": "pnpm --filter @cpt/api test",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "audit": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@cpt/api": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^17.2.3"
  }
}

